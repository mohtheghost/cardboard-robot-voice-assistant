[Unit]
Description=Cardboard robot voice assistant server (ESP32 <-> OpenAI bridge)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The unprivileged user the service runs as. Create it once (see server/README.md):
#   sudo useradd -r -s /usr/sbin/nologin -d /opt/robot-server robot
User=robot
WorkingDirectory=/opt/robot-server
ExecStart=/opt/robot-server/server
Restart=on-failure
RestartSec=5

# Secrets and settings live in a root-only file, one KEY=value per line, no quotes:
#   sudo install -m 600 /dev/null /etc/robot-server.env
#   sudo nano /etc/robot-server.env
# containing at least:
#   OPENAI_API_KEY=sk-...          <- your OWN key from https://platform.openai.com/api-keys (billed to you)
# and only if you flash the experimental firmware (the tested firmware sends no token):
#   ROBOT_AUTH_TOKEN=a-long-random-string
# optional: ROBOT_PORT=8080  ROBOT_SAMPLE_RATE=8000  ROBOT_WAKE_WORDS=assistant,hello,robot
#           ROBOT_LANGUAGE=en  ROBOT_TTS_VOICE=echo  ROBOT_KEEP_RECORDINGS=0
EnvironmentFile=/etc/robot-server.env
Environment=DOTNET_CLI_TELEMETRY_OPTOUT=1

# Console output goes to: journalctl -u robot-server -f
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
