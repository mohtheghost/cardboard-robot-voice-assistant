// Copy this file to secrets.h (same folder) and fill in your own values.
// secrets.h is listed in .gitignore so it never ends up in a public repository.
#pragma once

// WiFi network the robot should join (2.4 GHz only - the ESP32 has no 5 GHz radio)
#define WIFI_SSID        "your-wifi-name"
#define WIFI_PASS        "your-wifi-password"

// Where the C# server runs: public IP or hostname of your VPS, or your PC's LAN IP
#define VPS_HOST         "203.0.113.10"
#define VPS_PORT         8080

// Optional shared secret. Must match ROBOT_AUTH_TOKEN on the server.
// Leave it "" to connect to a server that has no token configured.
#define ROBOT_AUTH_TOKEN ""
